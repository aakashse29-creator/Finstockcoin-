rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all: prevent unauthorized reads/writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Test connection probe allowed for health checks
    match /test/connection {
      allow read: if true;
    }

    // User profiles: strictly isolated by UID
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && incoming().uid == existing().uid;
      allow delete: if false;

      // Subcollection: Orders
      match /orders/{orderId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(orderId) && incoming().userId == userId;
        allow update: if isOwner(userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // Subcollection: Watchlist
      match /watchlist/{pairId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(pairId) && incoming().userId == userId;
        allow update: if isOwner(userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
